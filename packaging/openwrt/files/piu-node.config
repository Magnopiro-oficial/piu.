# piu-node: painel do provider (HTTPS) e retransmissão LNNP v1.
# Depois de mudar: uci commit piu-node (o procd reinicia o serviço) ou /etc/init.d/piu-node restart
# Cada opção vira uma variável de ambiente do piu-node (veja apps/piu-node/README.md).

config piu-node 'main'
	option enabled '1'
	# Usuário sem privilégios criado pelo pacote. 'root' só para diagnóstico.
	option user 'piu-node'
	# Estado, certificado TLS e identidade do nó (persistente; entra no backup do sysupgrade).
	# PIU_NODE_DATA. Para poupar a flash, aponte para um pendrive (ex.: /mnt/sda1/piu-node).
	option data '/etc/piu-node'
	# PIU_NODE_PORT / PIU_NODE_LISTEN
	option port '8420'
	option listen '0.0.0.0'
	# PIU_NODE_HOSTS: nomes aceitos no cabeçalho Host (proteção contra DNS rebinding).
	list host 'piu-node.local'
	list host 'localhost'
	list host '127.0.0.1'
	# Acrescenta o IP da interface lan (ex.: 192.168.1.1) à lista acima.
	option lan_host '1'
	# PIU_RELEASE_PUBKEY: chave pública de release (SPKI DER em base64). Vazia: nenhum pacote oferecido.
	#option release_pubkey ''
	# Teto do heap do V8 em MiB (node --max-old-space-size). 48 para roteadores de 128 MB.
	option heap_mb '48'
	# Outras opções do node, separadas por espaço. Com 128 MB de RAM, acrescente '--lite-mode'
	# (sem o compilador otimizador do V8: menos memória, JS mais lento).
	option node_args '--max-semi-space-size=1'
	# Manda o stdout (onde aparece o código de pareamento) para o logread.
	option log_stdout '1'

config lnnp 'lnnp'
	# PIU_LNNP: 0 desliga o motor de retransmissão inteiro.
	option enabled '1'
	# PIU_LNNP_RELAY: 0 mantém os enlaces, mas não guarda nem repassa envelopes de terceiros.
	option relay '1'
	# PIU_LNNP_LISTEN / PIU_LNNP_PORT (TCP do enlace)
	option listen '0.0.0.0'
	option port '8422'
	# PIU_LNNP_DISCOVERY_PORT (UDP do anúncio); 'off' desliga a descoberta.
	option discovery_port '8423'
	# PIU_LNNP_BROADCAST: destinos do anúncio (ex.: 192.168.1.255, ou host:porta).
	list broadcast '255.255.255.255'
	# PIU_LNNP_PEERS: vizinhos fixos host:porta.
	#list peer '192.168.1.20:8422'
	# PIU_LNNP_ALLOW: só aceita estes nós (chave do nó em hex, 64 caracteres). Sem nenhum: qualquer nó LNNP.
	#list allow '<chave do nó em hex>'
	# PIU_LNNP_MEMORY_MB: teto de memória para envelopes guardados (em RAM nesta versão).
	# O padrão do piu-node (256) não cabe num roteador de 128 MB.
	option memory_mb '16'
	# PIU_LNNP_BEACON_MS: intervalo do anúncio e das reconexões.
	option beacon_ms '5000'

# Adaptador serial/LoRa (rádio por USB). Descomente quando o piu-node suportar.
# O usuário piu-node está no grupo dialout, dono das portas /dev/tty* no OpenWrt.
#config serial 'serial'
#	# PIU_SERIAL: porta serial do rádio
#	option device '/dev/ttyUSB0'
#	# PIU_LORA_SF: spreading factor
#	option lora_sf ''
#	# PIU_LORA_BW_KHZ: largura de banda em kHz
#	option lora_bw_khz ''
#	# PIU_LORA_CR: coding rate
#	option lora_cr ''
#	# PIU_LORA_DUTY: limite de duty cycle
#	option lora_duty ''
#	# PIU_LORA_MAX_ENVELOPE: maior envelope enviado pelo rádio
#	option max_envelope ''

# piu-node: painel do provider (HTTPS) e retransmissão LNNP v1.
# Depois de mudar: uci commit piu-node (o procd reinicia o serviço) ou /etc/init.d/piu-node restart
# Cada opção vira uma variável de ambiente do piu-node (veja apps/piu-node/README.md).

config piu-node 'main'
	option enabled '1'
	# Usuário sem privilégios criado pelo pacote. 'root' só para diagnóstico.
	option user 'piu-node'
	# Estado, certificado TLS e identidade do nó (persistente; entra no backup do sysupgrade).
	# PIU_NODE_DATA. Para poupar a flash, aponte para um pendrive (ex.: /mnt/sda1/piu-node).
	option data '/etc/piu-node'
	# PIU_NODE_PORT / PIU_NODE_LISTEN
	option port '8420'
	option listen '0.0.0.0'
	# PIU_NODE_HOSTS: nomes aceitos no cabeçalho Host (proteção contra DNS rebinding).
	# Só vale incluir um nome que a rede resolve de fato (ex.: um nome do DNS do roteador). O pacote não
	# anuncia nenhum nome por mDNS (piu-node.local não resolve): abra o painel pelo IP da lan (lan_host).
	list host 'localhost'
	list host '127.0.0.1'
	# Acrescenta o IP da interface lan (ex.: 192.168.1.1) à lista acima.
	option lan_host '1'
	# PIU_RELEASE_PUBKEY: chave pública de release (SPKI DER em base64). Vazia: nenhum pacote oferecido.
	#option release_pubkey ''
	# Teto do heap do V8 em MiB (node --max-old-space-size). 48 para roteadores de 128 MB.
	option heap_mb '48'
	# Outras opções do node, separadas por espaço. Com 128 MB de RAM, acrescente '--lite-mode'
	# (sem o compilador otimizador do V8: menos memória, JS mais lento).
	option node_args '--max-semi-space-size=1'
	# Manda o stdout para o logread (o código de pareamento fica em /etc/piu-node/pairing-code).
	option log_stdout '1'

config lnnp 'lnnp'
	# PIU_LNNP: 0 desliga o motor de retransmissão inteiro.
	option enabled '1'
	# PIU_LNNP_RELAY: 0 mantém os enlaces, mas não guarda nem repassa envelopes de terceiros.
	option relay '1'
	# PIU_LNNP_LISTEN / PIU_LNNP_PORT (TCP do enlace)
	option listen '0.0.0.0'
	option port '8422'
	# PIU_LNNP_DISCOVERY_PORT (UDP do anúncio); 'off' desliga a descoberta.
	option discovery_port '8423'
	# PIU_LNNP_BROADCAST: destinos do anúncio (ex.: 192.168.1.255, ou host:porta).
	list broadcast '255.255.255.255'
	# PIU_LNNP_PEERS: vizinhos fixos host:porta.
	#list peer '192.168.1.20:8422'
	# PIU_LNNP_ALLOW: só aceita estes nós (chave do nó em hex, 64 caracteres). Sem nenhum: qualquer nó LNNP.
	#list allow '<chave do nó em hex>'
	# PIU_LNNP_MEMORY_MB: teto de memória para envelopes guardados (em RAM nesta versão).
	# O padrão do piu-node (256) não cabe num roteador de 128 MB.
	option memory_mb '16'
	# PIU_LNNP_BEACON_MS: intervalo do anúncio e das reconexões.
	option beacon_ms '5000'
	# PIU_RELAY_SAMPLE_MS: intervalo das amostras do histórico de retransmissão (padrão 300000 = 5 min).
	#option sample_ms '300000'
	# PIU_RELAY_PERSIST_MS: intervalo para gravar as mensagens guardadas quando mudam (padrão 30000).
	#option persist_ms '30000'

# Gateway da carga pela malha: transações assinadas nos celulares sem internet seguem daqui para a
# Lunes Mainnet (só com rota até a Lunes). O dono também liga/desliga e muda a caixa pelo painel.
config gateway 'gateway'
	# PIU_GATEWAY: 0 desliga de vez (o painel não liga).
	option enabled '1'
	# PIU_VALIDATOR_INBOX: caixa do validador para as evidências de entrega (só https://, servidor na
	# internet). Vazia: este nó não entrega pacotes de evidências.
	#option inbox 'https://…'

# Rádio LoRa ou cabo USB pela porta serial. EXPERIMENTAL: o piu-node já lê PIU_SERIAL, mas só foi
# testado com rádio simulado e pseudo-terminais, ainda não com placa real. Para ligar, descomente a seção.
# O rádio LoRa precisa de firmware de modem KISS (frequência, SF e banda ficam no firmware).
# O usuário piu-node está no grupo dialout, dono das portas /dev/tty* no OpenWrt.
#config serial 'serial'
#	# PIU_SERIAL: tipo:caminho@velocidade, tipo lora ou usb. Várias portas: uma `list device` por porta.
#	option device 'lora:/dev/ttyUSB0@115200'
#	# PIU_LORA_SF: spreading factor, igual ao do firmware (7–12; vazio = 9)
#	option lora_sf ''
#	# PIU_LORA_BW_KHZ: largura de banda em kHz (62.5, 125, 250 ou 500; vazio = 125)
#	option lora_bw_khz ''
#	# PIU_LORA_CR: coding rate 4/5 a 4/8 (5–8; vazio = 5)
#	option lora_cr ''
#	# PIU_LORA_DUTY: ocupação máxima do canal, % por hora (vazio = 10)
#	option lora_duty ''
#	# PIU_LORA_MAX_ENVELOPE: maior envelope enviado pelo rádio, em bytes (vazio = 1536)
#	option max_envelope ''
#	# PIU_LORA_BEACON_MS: intervalo do anúncio pelo rádio (vazio = 30000)
#	option beacon_ms ''

# Leitura do saldo da carteira de provider na Lunes Mainnet (só leitura).
#config lunes 'lunes'
#	# PIU_LUNES_ENDPOINTS: WebSocket da Mainnet, na ordem de tentativa. Sem nenhum: os 4 de produção.
#	list endpoint 'wss://ws.lunes.io'

# Headers de segurança do site (formato Cloudflare Pages).
# Recomendado: publicar atrás da Cloudflare (WAF, DDoS, TLS 1.3, HSTS). Em outra hospedagem,
# aplique os mesmos valores (ver README).
# A CSP completa (com hashes) vai em <meta> em cada página, gerada pelo Astro (astro.config.mjs).
# Por header ficam só as diretivas que <meta> não suporta ou que reforçam a política.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Painel embutido: só o próprio site pode exibi-lo em iframe.
# "! Header" remove o valor herdado de /* (sintaxe da Cloudflare Pages) antes de definir o novo.
/painel/*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'
  X-Frame-Options: SAMEORIGIN

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

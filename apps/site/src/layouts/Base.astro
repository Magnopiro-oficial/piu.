---
import '@fontsource-variable/geist';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import 'material-symbols/rounded.css';
import '../styles/site.css';
import type { Dict } from '../i18n/pt';

interface Props { t: Dict; alt: Dict }
const { t, alt } = Astro.props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : null);
const canonical = abs(t.path);
const alternates = [t, alt].map(d => ({ lang: d.lang, href: abs(d.path) })).filter(a => a.href);
---
<!doctype html>
<html lang={t.lang} data-piu-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={t.lang.replace('-', '_')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <!-- Tema antes da primeira pintura: script externo e bloqueante (compatível com CSP sem 'unsafe-inline'). -->
    <script is:inline src="/theme-init.js"></script>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body>
    <slot />
  </body>
</html>

{
  "name": "piu",
  "productName": "Piu",
  "version": "0.1.1",
  "private": true,
  "description": "Piu para computador (macOS, Linux e Windows): o mensageiro da malha Piu, conectado à rede local por LNNP",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Lunes Network"
  },
  "homepage": "https://github.com/lunes-platform/piu.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lunes-platform/piu..git",
    "directory": "apps/desktop"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "deps": "npm --prefix ../mobile ci --ignore-scripts && npm --prefix ../piu-node ci --ignore-scripts",
    "dev": "node scripts/dev-brand.mjs && node build.mjs && vite build --mode development && electron .",
    "dev:renderer": "vite",
    "build": "node build.mjs && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node scripts/dev-brand.mjs && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "2.4.0",
    "material-symbols": "^0.48.2",
    "openpgp": "6.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^7.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}

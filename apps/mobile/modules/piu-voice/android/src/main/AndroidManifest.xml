<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Áudio da chamada de voz. RECORD_AUDIO é pedida em tempo de execução pelo app; enquanto o app.json
       a listar em "blockedPermissions" (tools:node="remove" no manifesto do app), ela é retirada na fusão
       e start() rejeita com 'PERMISSION'. MODIFY_AUDIO_SETTINGS (normal): modo de comunicação e rota
       (alto-falante, fone do aparelho, Bluetooth). -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <!-- Chamada fora do app (PiuCallAlertModule): vibração ao tocar, notificação de chamada recebida
       (pedida pelo app no Android 13+) e tela cheia sobre a tela bloqueada. No Android 14+ a tela cheia
       depende de a pessoa (ou a loja) liberar USE_FULL_SCREEN_INTENT; sem ela vira aviso no topo. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <!-- Serviço em primeiro plano do microfone durante a chamada (PiuCallService): sem ele o Android
       corta o microfone com a tela bloqueada. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

  <application>
    <service
      android:name="expo.modules.piuvoice.PiuCallService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
  </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.piuappshare" >

    <uses-sdk android:minSdkVersion="24" />

    <application>

        <!-- Só a cópia do instalador em cache/piu-share sai do app, e só para quem a pessoa escolher. -->
        <provider
            android:name="expo.modules.piuappshare.PiuShareFileProvider"
            android:authorities="dollar_openBracket_applicationId_closeBracket.piushare"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/piu_share_paths" />
        </provider>
    </application>

</manifest>